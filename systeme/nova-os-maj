#!/bin/bash
# Mises à jour du système Nova OS installé sur disque (deux emplacements A et B, retour automatique).
#
#   nova-os-maj etat                  état du système (lignes ETAT clé=valeur)
#   nova-os-maj chercher              cherche une version plus récente (clé USB, puis GitHub)
#   nova-os-maj installer             télécharge ou copie la version trouvée dans l'emplacement libre,
#                                     puis la prépare pour UN essai au prochain démarrage
#   nova-os-maj valider               (au démarrage, par nova-os-valider.timer) garde la nouvelle version
#                                     si elle a tenu ; sinon note l'échec
#   nova-os-maj precedente            redémarre une fois sur l'autre version (sans la garder)
#   nova-os-maj revenir               garde définitivement l'autre version
#
# Une version publiée = les fichiers d'une « release » GitHub de nova-os : nova-os-systeme.txt (manifeste),
# vmlinuz, initrd.img, filesystem.squashfs.part0, .part1… Les mêmes fichiers, posés dans un dossier
# « nova-os-maj » à la racine d'une clé USB (FAT32, exFAT ou NTFS), servent sans Internet.
#
# Sortie lue par Nova : « ETAT k=v », « PROGRES n », « MESSAGE texte », « OK texte », « ERREUR texte ».
set -uo pipefail
. /usr/local/sbin/nova-os-commun

[ "$(id -u)" = 0 ] || { echo "ERREUR à lancer en administrateur (sudo)"; exit 1; }
CMD="${1:-etat}"
SLOT="$(nova_slot_demarre)"
CLE_MNT="/run/nova-os-cle"
CACHE="/run/nova-os-maj"   # dernier manifeste trouvé (source + contenu)

disque_requis() {
  [ -n "$SLOT" ] || nova_err "Nova OS tourne depuis la clé USB : les mises à jour du système concernent un Nova OS installé sur le disque. Pour la clé, réécris-la avec Rufus."
  SYS="$(nova_sys_dir)" || nova_err "partition $NOVA_SYS_LABEL introuvable"
  ENV="$SYS/boot/grub/grubenv"
  [ -f "$ENV" ] || nova_err "menu de démarrage introuvable ($ENV)"
}

version_slot() { cat "$SYS/systeme/$1/version" 2>/dev/null || true; }
num() { printf '%s' "$1" | sed -n 's/^\([0-9][0-9]*\).*/\1/p'; }   # « 12 » pour comparer, vide si inconnu

# ---------- sources ----------
# Clé USB : monte en lecture seule chaque partition amovible FAT/exFAT/NTFS et y cherche nova-os-maj/
trouver_cle() {
  [ -n "${NOVA_TEST_SOURCE_DIR:-}" ] && { echo "$NOVA_TEST_SOURCE_DIR"; return 0; }
  local dev fs hp mp
  while read -r dev fs hp; do
    case "$fs" in vfat|exfat|ntfs|ntfs3) ;; *) continue ;; esac
    mp="$(findmnt -rn -S "$dev" -o TARGET | head -1)"
    if [ -z "$mp" ]; then
      mp="$CLE_MNT/$(basename "$dev")"
      mkdir -p "$mp"
      mount -o ro "$dev" "$mp" 2>/dev/null || mount -t ntfs3 -o ro "$dev" "$mp" 2>/dev/null || { rmdir "$mp"; continue; }
    fi
    if [ -f "$mp/nova-os-maj/nova-os-systeme.txt" ]; then echo "$mp/nova-os-maj"; return 0; fi
    case "$mp" in "$CLE_MNT"/*) umount "$mp" 2>/dev/null; rmdir "$mp" 2>/dev/null ;; esac
  done < <(lsblk -lnpo NAME,FSTYPE,HOTPLUG | awk '$2!="" && $3=="1"')
  return 1
}
demonter_cles() { for m in "$CLE_MNT"/*; do [ -d "$m" ] && { umount "$m" 2>/dev/null; rmdir "$m" 2>/dev/null; }; done; true; }

github_url() { echo "https://github.com/$(nova_depot)/releases/$1"; }

chercher() {
  disque_requis
  mkdir -p "$CACHE"
  rm -f "$CACHE/manifeste" "$CACHE/source"
  local d
  if d="$(trouver_cle)"; then
    cp "$d/nova-os-systeme.txt" "$CACHE/manifeste"
    echo "cle $d" >"$CACHE/source"
  else
    nova_msg "recherche sur GitHub ($(nova_depot))"
    curl -fsSL --retry 2 --connect-timeout 15 -m 60 -o "$CACHE/manifeste" "$(github_url latest/download/nova-os-systeme.txt)" ||
      nova_err "aucune version trouvée : pas de clé avec un dossier nova-os-maj, et GitHub ne répond pas (Internet ?) ou la dernière construction n'a pas publié nova-os-systeme.txt"
    echo "github $(awk '$1=="tag"{print $2}' "$CACHE/manifeste")" >"$CACHE/source"
  fi
  local dispo cur
  dispo="$(awk '$1=="nova-os"{print $2}' "$CACHE/manifeste")"
  [ -n "$dispo" ] || nova_err "manifeste illisible"
  cur="$(nova_version_image)"
  echo "ETAT disponible=$dispo"
  echo "ETAT source=$(cut -d' ' -f1 "$CACHE/source")"
  if [ "$dispo" = "$cur" ] || { [ -n "$(num "$dispo")" ] && [ -n "$(num "$cur")" ] && [ "$(num "$dispo")" -le "$(num "$cur")" ]; }; then
    echo "ETAT a_jour=1"
    echo "OK Nova OS est à jour (version $cur)"
  else
    echo "ETAT a_jour=0"
    echo "OK Nova OS $dispo disponible ($(cut -d' ' -f1 "$CACHE/source" | sed 's/cle/sur la clé USB/;s/github/sur GitHub/'))"
  fi
}

# ---------- installation dans l'emplacement libre ----------
installer() {
  disque_requis
  [ -f "$CACHE/manifeste" ] || chercher >/dev/null
  [ -f "$CACHE/manifeste" ] || nova_err "rien à installer"
  local src kind where cible tmp total besoin libre dispo
  read -r kind where <"$CACHE/source"
  dispo="$(awk '$1=="nova-os"{print $2}' "$CACHE/manifeste")"
  cible="$(nova_autre_slot "$SLOT")"
  tmp="$SYS/systeme/$cible.nouveau"
  total="$(awk '$1=="fichier"{s+=$3} END{print s+0}' "$CACHE/manifeste")"
  libre=$(( $(df -B1 --output=avail "$SYS" | tail -1) ))
  besoin=$(( total + 300 * 1048576 - $(du -sb "$SYS/systeme/$cible" 2>/dev/null | cut -f1 || echo 0) ))
  [ "$libre" -ge "$besoin" ] || nova_err "pas assez de place sur $NOVA_SYS_LABEL ($((libre / 1048576)) Mo libres, $((besoin / 1048576)) Mo nécessaires)"

  nova_sys_rw "$SYS" || nova_err "impossible d'écrire sur $NOVA_SYS_LABEL"
  trap 'nova_sys_ro "$SYS"; demonter_cles' EXIT
  # l'emplacement libre contient l'avant-dernière version : elle est remplacée. Un téléchargement
  # interrompu de la même version est repris là où il s'était arrêté.
  [ "$(cat "$tmp/.pour" 2>/dev/null)" = "$dispo" ] || rm -rf "$tmp"
  mkdir -p "$tmp"
  echo "$dispo" >"$tmp/.pour"
  nova_msg "installation de Nova OS $dispo dans l'emplacement $cible"

  local fait=0 f taille somme
  while read -r _ f taille somme; do
    case "$f" in */*|..*|"") nova_err "nom de fichier refusé dans le manifeste : $f" ;; esac
    if [ "$(stat -c %s "$tmp/$f" 2>/dev/null)" = "$taille" ] && [ "$(sha256sum "$tmp/$f" | cut -d' ' -f1)" = "$somme" ]; then
      fait=$((fait + taille))
      continue
    fi
    if [ "$kind" = "cle" ]; then
      [ -f "$where/$f" ] || nova_err "fichier manquant sur la clé : $f"
      ( dd if="$where/$f" of="$tmp/$f" bs=4M status=none ) &
    else
      ( curl -fsSL --retry 5 --retry-delay 5 --connect-timeout 20 -C - -o "$tmp/$f" "$(github_url "download/$where/$f")" ) &
    fi
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      sleep 2
      echo "PROGRES $(( (fait + $(stat -c %s "$tmp/$f" 2>/dev/null || echo 0)) * 90 / total ))"
    done
    wait "$pid" || nova_err "copie ou téléchargement de $f interrompu (relance : le téléchargement reprend où il s'est arrêté)"
    [ "$(stat -c %s "$tmp/$f")" = "$taille" ] || nova_err "$f : taille incorrecte"
    [ "$(sha256sum "$tmp/$f" | cut -d' ' -f1)" = "$somme" ] || nova_err "$f : fichier abîmé (somme de contrôle fausse)"
    fait=$((fait + taille))
  done < <(awk '$1=="fichier"' "$CACHE/manifeste")

  # le système est publié en morceaux (limite de 2 Go par fichier sur GitHub) : on les recolle
  nova_msg "assemblage du système"
  echo "PROGRES 92"
  : >"$tmp/filesystem.squashfs"
  for f in $(awk '$1=="fichier" && $2 ~ /^filesystem\.squashfs\.part[0-9]+$/ {print $2}' "$CACHE/manifeste" | sort -V); do
    cat "$tmp/$f" >>"$tmp/filesystem.squashfs" && rm -f "$tmp/$f"
  done
  somme="$(awk '$1=="somme" && $2=="filesystem.squashfs"{print $3}' "$CACHE/manifeste")"
  [ -n "$somme" ] && [ "$(sha256sum "$tmp/filesystem.squashfs" | cut -d' ' -f1)" = "$somme" ] || nova_err "système assemblé abîmé (somme de contrôle fausse)"
  for f in vmlinuz initrd.img filesystem.squashfs; do [ -s "$tmp/$f" ] || nova_err "$f manquant"; done
  echo "$dispo" >"$tmp/version"

  echo "PROGRES 97"
  sync
  rm -rf "$SYS/systeme/$cible"
  rm -f "$tmp/.pour"
  mv "$tmp" "$SYS/systeme/$cible"
  sync
  grub-editenv "$ENV" set nova_essai="$cible" nova_attente="$cible"
  grub-editenv "$ENV" unset nova_echec
  sync
  nova_log "Nova OS $dispo prêt dans $cible : essai au prochain démarrage"
  echo "PROGRES 100"
  echo "OK Nova OS $dispo est prêt : il sera essayé au prochain démarrage. S'il ne démarre pas, éteins et rallume : l'ancienne version reprend toute seule."
}

# ---------- au démarrage : garder la nouvelle version si elle tient ----------
valider() {
  [ -n "$SLOT" ] || exit 0
  SYS="$(nova_sys_dir)" || exit 0
  ENV="$SYS/boot/grub/grubenv"
  local attente actif
  attente="$(nova_env_get "$ENV" nova_attente)"
  actif="$(nova_env_get "$ENV" nova_actif)"
  [ -n "$attente" ] || exit 0
  nova_sys_rw "$SYS" || exit 1
  if [ "$attente" = "$SLOT" ]; then
    grub-editenv "$ENV" set nova_actif="$SLOT"
    grub-editenv "$ENV" unset nova_attente nova_echec
    nova_log "Nova OS $(version_slot "$SLOT") validée (emplacement $SLOT)"
    echo "OK nouvelle version gardée"
  elif [ -z "$(nova_env_get "$ENV" nova_essai)" ]; then
    # l'essai a été consommé, mais c'est l'ancienne version qui tourne : la nouvelle n'a pas tenu
    grub-editenv "$ENV" set nova_echec="$attente"
    grub-editenv "$ENV" unset nova_attente
    nova_log "ÉCHEC : Nova OS $(version_slot "$attente") (emplacement $attente) n'a pas démarré, retour sur $SLOT"
    echo "OK échec noté"
  fi
  nova_sys_ro "$SYS"
}

etat() {
  echo "ETAT version=$(nova_version_image)"
  echo "ETAT depot=$(nova_depot)"
  if [ -z "$SLOT" ]; then echo "ETAT mode=cle"; echo "OK Nova OS tourne depuis la clé USB"; return; fi
  SYS="$(nova_sys_dir)" || { echo "ETAT mode=disque"; nova_err "partition $NOVA_SYS_LABEL introuvable"; }
  ENV="$SYS/boot/grub/grubenv"
  local autre; autre="$(nova_autre_slot "$SLOT")"
  echo "ETAT mode=disque"
  echo "ETAT slot=$SLOT"
  echo "ETAT actif=$(nova_env_get "$ENV" nova_actif)"
  echo "ETAT autre=$autre"
  echo "ETAT autre_version=$(version_slot "$autre")"
  echo "ETAT attente=$(nova_env_get "$ENV" nova_attente)"
  echo "ETAT essai=$(nova_env_get "$ENV" nova_essai)"
  echo "ETAT echec=$(nova_env_get "$ENV" nova_echec)"
  echo "ETAT echec_version=$(v="$(nova_env_get "$ENV" nova_echec)"; [ -n "$v" ] && version_slot "$v")"
  echo "ETAT libre_mo=$(( $(df -B1 --output=avail "$SYS" | tail -1) / 1048576 ))"
  echo "OK état lu"
}

autre_version() { # $1 = essai (une fois) | garder
  disque_requis
  local autre; autre="$(nova_autre_slot "$SLOT")"
  [ -f "$SYS/systeme/$autre/vmlinuz" ] || nova_err "pas d'autre version sur le disque"
  nova_sys_rw "$SYS" || nova_err "impossible d'écrire sur $NOVA_SYS_LABEL"
  if [ "$1" = "garder" ]; then
    grub-editenv "$ENV" set nova_actif="$autre"
    grub-editenv "$ENV" unset nova_essai nova_attente
    echo "OK au prochain démarrage, Nova OS $(version_slot "$autre") devient la version habituelle"
  else
    grub-editenv "$ENV" set nova_essai="$autre"
    echo "OK au prochain démarrage seulement, Nova OS $(version_slot "$autre") (version précédente)"
  fi
  nova_sys_ro "$SYS"
}

case "$CMD" in
  etat) etat ;;
  chercher) chercher; demonter_cles ;;
  installer) installer ;;
  valider) valider ;;
  precedente) autre_version essai ;;
  revenir) autre_version garder ;;
  *) echo "ERREUR commande inconnue : $CMD"; exit 2 ;;
esac
