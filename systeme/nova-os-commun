#!/bin/bash
# Nova OS : fonctions partagées par nova-os-installer et nova-os-maj (lu avec « . », pas lancé seul).
#
# Organisation d'un Nova OS installé sur disque :
#   partition NOVA_SYSTEME (ext4) : /systeme/A et /systeme/B (vmlinuz, initrd.img, filesystem.squashfs,
#                                   version), /boot/grub (menu, grubenv), sauvegarde du MBR ;
#   partition nova-donnees (ext4)  : persistance live-boot (persistence.conf) : /home (donc ~/Nova),
#                                   Wi-Fi, appairages Bluetooth, journal du système.
# Le système lui-même n'est jamais modifié : une mise à jour remplace l'emplacement qui ne tourne pas.
#
# Variables GRUB (grubenv) :
#   nova_actif   emplacement démarré d'habitude (A ou B) ;
#   nova_essai   emplacement à essayer UNE fois au prochain démarrage (GRUB l'efface en démarrant) ;
#   nova_attente emplacement en cours d'essai, validé quand le système a tenu quelques minutes ;
#   nova_echec   emplacement dont l'essai a échoué (le PC est revenu sur l'ancien).

NOVA_SYS_LABEL="NOVA_SYSTEME"
NOVA_DATA_LABEL="nova-donnees"
NOVA_ETC="/etc/nova-os"
NOVA_SYS_MNT="/run/nova-systeme"
NOVA_LOG_DIR="/var/log/nova-os"
NOVA_TAILLE_SYSTEME_MIB=12288   # 12 Go : deux versions du système + un téléchargement
NOVA_TAILLE_MIN_MIB=20480       # 20 Go minimum d'espace libre pour installer

nova_log() {
  mkdir -p "$NOVA_LOG_DIR" 2>/dev/null || true
  printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$NOVA_LOG_DIR/nova-os.log" 2>/dev/null || true
}
# messages lisibles par Nova : MESSAGE / PROGRES / ERREUR / OK
nova_msg() { echo "MESSAGE $*"; nova_log "$*"; }
nova_err() { echo "ERREUR $*"; nova_log "ERREUR $*"; exit 1; }

nova_version_image() { cat "$NOVA_ETC/version" 2>/dev/null || echo "inconnue"; }
nova_depot() { cat "$NOVA_ETC/depot" 2>/dev/null || echo "Emptyrl/nova-os"; }

# emplacement démarré (A/B), vide si on ne tourne pas depuis le disque (clé USB)
nova_slot_demarre() { [ -n "${NOVA_TEST_SLOT:-}" ] && { echo "$NOVA_TEST_SLOT"; return; }; tr ' ' '\n' </proc/cmdline | sed -n 's/^nova_slot=\([AB]\)$/\1/p' | head -1; }
nova_autre_slot() { [ "$1" = "A" ] && echo B || echo A; }

# partition système : périphérique, et dossier où elle est montée (montée au besoin)
nova_sys_dev() { blkid -L "$NOVA_SYS_LABEL" 2>/dev/null | head -1; }
nova_sys_dir() {
  local dev mp
  dev="$(nova_sys_dev)"
  [ -n "$dev" ] || return 1
  mp="$(findmnt -rn -S "$dev" -o TARGET | head -1)"
  if [ -z "$mp" ]; then
    mkdir -p "$NOVA_SYS_MNT"
    mount "$dev" "$NOVA_SYS_MNT" || return 1
    mp="$NOVA_SYS_MNT"
  fi
  echo "$mp"
}
# écriture sur la partition système (live-boot la monte en lecture seule)
nova_sys_rw() { local mp="$1"; findmnt -rn -o OPTIONS --target "$mp" | grep -q '^rw' || mount -o remount,rw "$mp"; }
nova_sys_ro() { local mp="$1"; sync; [ "$mp" = "$NOVA_SYS_MNT" ] && return 0; mount -o remount,ro "$mp" 2>/dev/null || true; }

nova_env_get() { # fichier variable
  grub-editenv "$1" list 2>/dev/null | sed -n "s/^$2=//p" | head -1
}

# Menu GRUB d'un Nova OS sur disque. $1 = dossier de la partition système, $2 = bios|efi.
nova_ecrire_grub_cfg() {
  local sys="$1" mode="$2" cmd win
  cmd="$(cat "$NOVA_ETC/cmdline" 2>/dev/null || echo "quiet splash")"
  if [ "$mode" = "efi" ]; then
    win='insmod fat
if search --no-floppy --file --set=nova_win /EFI/Microsoft/Boot/bootmgfw.efi; then
  set timeout=3
  menuentry "Windows" { set root=$nova_win; chainloader /EFI/Microsoft/Boot/bootmgfw.efi }
fi'
  else
    win='insmod ntfs
insmod chain
if search --no-floppy --file --set=nova_win /bootmgr; then
  set timeout=3
  menuentry "Windows" { set root=$nova_win; chainloader +1 }
fi'
  fi
  mkdir -p "$sys/boot/grub"
  cat >"$sys/boot/grub/grub.cfg" <<EOF
# Nova OS : menu de démarrage, écrit par nova-os-installer. Ne pas modifier à la main.
insmod part_msdos
insmod part_gpt
insmod ext2
insmod all_video
search --no-floppy --label $NOVA_SYS_LABEL --set=root
set nova_env=(\$root)/boot/grub/grubenv
load_env --file \$nova_env
if [ -z "\$nova_actif" ]; then set nova_actif=A; fi
set nova_boot=\$nova_actif
# une nouvelle version s'essaie une seule fois : si elle plante, le démarrage suivant reprend l'ancienne
if [ -n "\$nova_essai" ]; then
  set nova_boot=\$nova_essai
  set nova_essai=
  save_env --file \$nova_env nova_essai
fi
if [ "\$nova_boot" = "A" ]; then set nova_autre=B; else set nova_autre=A; fi
set default=0
set timeout=1
set gfxpayload=keep

function nova_lancer {
  linux /systeme/\$1/vmlinuz boot=live live-media-path=/systeme/\$1 persistence persistence-label=$NOVA_DATA_LABEL nova_slot=\$1 $cmd
  initrd /systeme/\$1/initrd.img
}

menuentry "Nova OS" { nova_lancer \$nova_boot }
if [ -f /systeme/\$nova_autre/vmlinuz ]; then
  menuentry "Nova OS (version precedente)" { nova_lancer \$nova_autre }
fi
$win
EOF
}
